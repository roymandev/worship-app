    "cn": "^0.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.15.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
